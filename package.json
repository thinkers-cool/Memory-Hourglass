{
  "name": "memhg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -- --test-threads=1",
    "test:rust:coverage": "cargo +nightly llvm-cov --manifest-path src-tauri/Cargo.toml --ignore-filename-regex 'main\\.rs$|test_support/.*$|smb/credentials\\.rs$|commands/.*\\.rs$|lib\\.rs$' --fail-uncovered-lines 0 --fail-under-regions 100 -- --test-threads=1",
    "test:e2e": "cargo test --manifest-path src-tauri/Cargo.toml && vitest run",
    "test:all": "npm run test:rust && npm run test",
    "lint": "eslint src",
    "fmt": "prettier --check .",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "culori": "^4.0.2",
    "emoji-picker-react": "^4.20.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.41.0",
    "react": "^19.1.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.13",
    "react-zoom-pan-pinch": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.8",
    "@tauri-apps/cli": "^2.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "daisyui": "^5.0.43",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
